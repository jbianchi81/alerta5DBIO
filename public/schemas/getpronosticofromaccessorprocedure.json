{
    "$id": "getpronosticofromaccessorprocedure.json",
    "schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GetPronosticoFromAccessorProcedure",
    "type": "object",
    "allOf": [{ "$ref": "crudprocedure.json" }],
    "properties": {
        "procedureName": {
            "const": "GetPronosticoFromAccessorProcedure"
        },
        "arguments": {
            "type": "object",
            "properties": {
                "accessor_id": {
                    "type": "string",
                    "description": "Identifier of the Accessor class to be called for forecast retrieval"
                },
                "classname": {
                    "type": "string",
                    "description": "Class of the accessor. Together with 'config', sets a new accessor instance without reading the configuration from the database"
                },
                "config": {
                    "type": "string",
                    "description": "Configuration of the accessor. Together with 'classname', sets a new accessor instance without reading the configuration from the database"
                },
                "filter": {
                    "$ref": "pronosticosfilter.json"
                },
                "options": {
                    "type": "object",
                    "allOf": [{
                        "$ref": "crudprocedureoptions.json"
                    }],
                    "properties": {
                        "includeProno": {
                            "type": "boolean"
                        } 
                    }
                }
            },
            "required": [
                "accessor_id",
                "filter"
            ]
        }
    }
}
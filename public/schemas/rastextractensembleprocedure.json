{
    "$id": "rastextractensembleprocedure.json",
    "schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RastExtractEnsembleProcedure",
    "type": "object",
    "allOf": [{ "$ref": "crudprocedure.json" }],
    "properties": {
        "procedureName": {
            "const": "RastExtractEnsembleProcedure"
        },
        "arguments": {
            "type": "object",
            "properties": {
                "filter": {
                    "description": "filter to select which raster records to extract",
                    "type": "object",
                    "properties": {
                        "series_id": {
                            "type": "integer"
                        },
                        "timestart": {
                            "$ref": "dateorinterval.json"
                        },
                        "timeend": {
                            "$ref": "dateorinterval.json"
                        },
                        "cal_id": {
                            "type": "integer"
                        },
                        "cor_id": {
                            "type": "integer"
                        },
                        "forecast_date": {
                            "$ref": "dateorinterval.json"
                        },
                        "qualifier": {
                            "type": "string"
                        } 
                    },
                    "additionalProperties": true
                },
                "filepath_prefix": {
                    "type": "string",
                    "description": "write result files using this prefix"
                }
            },
            "required": [
                "filter",
                "filepath_prefix"
            ]
        }
    }
}
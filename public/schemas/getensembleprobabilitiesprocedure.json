{
    "$id": "getensembleprobabilities.json",
    "schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GetEnsembleProbabilities",
    "type": "object",
    "allOf": [{ "$ref": "crudprocedure.json" }],
    "properties": {
        "procedureName": {
            "const": "GetEnsembleProbabilitiesProcedure"
        },
        "arguments": {
            "type": "object",
            "properties": {
                "filter": {
                    "description": "filter to select which raster records to extract",
                    "type": "object",
                    "properties": {
                        "series_id": {
                            "type": "integer"
                        },
                        "timestart": {
                            "$ref": "dateorinterval.json"
                        },
                        "timeend": {
                            "$ref": "dateorinterval.json"
                        },
                        "cal_id": {
                            "type": "integer"
                        },
                        "cor_id": {
                            "type": "integer"
                        },
                        "forecast_date": {
                            "$ref": "dateorinterval.json"
                        },
                        "qualifier": {
                            "type": "string"
                        } 
                    },
                    "additionalProperties": true
                },
                "gdal_output_dir": {
                    "type": "string"
                },
                "png_output_dir": {
                    "type": "string"
                },
                "thresholds": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "color_rules": {
                    "type": "string"
                },
                "category_cuts": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "overwrite": {
                    "type": "boolean"
                },
                "output_prefix": {
                    "type": "string"
                },
                "output_series_id": {
                    "type": "number"
                },
                "product": {
                    "type": "string"
                },
                "date_base_dir": {
                    "type": "string"
                },
                "insert": {
                    "type": "boolean"
                }
            },
            "required": [
                "filter"
            ]
        }
    }
}
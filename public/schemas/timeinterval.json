{
    "$id": "timeinterval.json",
    "schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TimeInterval",
    "anyOf": [
        {
            "type": "number"
        },
        {
            "type": "object",
            "properties": {
                "hours": {
                    "type": "number"
                },
                "minutes": {
                    "type": "number"
                },
                "seconds": {
                    "type": "number"
                },
                "milliseconds": {
                    "type": "number"
                },
                "months": {
                    "type": "number"
                },
                "days": {
                    "type": "number"
                },
                "roundTo": {
                    "type": "object",
                    "properties": {
                        "hour": { "type": "number"}, 
                        "month": { "type": "number"}, 
                        "day": { "type": "number"}, 
                        "minute": { "type": "number"}
                    }
                },
                "set": {
                    "type": "object",
                    "properties": {
                        "hour": { "type": "number"}, 
                        "month": { "type": "number"}, 
                        "day": { "type": "number"}, 
                        "minute": { "type": "number"},
                        "second": { "type": "number"},
                        "millisecond": { "type": "number"},
                        "time": { "type": "number"}
                    }
                }
            },
            "additionalProperties": false
        }
    ]
}

  
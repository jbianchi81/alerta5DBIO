<link rel="stylesheet" href="css/ol.css" type="text/css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css">
<script src="js/ol.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="js/map_viewer.js" defer></script>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
/>
<style>
	.map-viewer-page {
		max-width: 1440px;
		width: 100%;
		padding: 1rem;
		margin: 0 auto;
	}
	.map-viewer-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 1rem;
		padding: 1rem;
		background: #f4f7fa;
		border-radius: .35rem;
		margin-bottom: 1rem;
	}
	.map-viewer-controls > .form-group {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 180px;
		margin: 0;
	}
	.map-viewer-controls label {
		font-weight: 600;
		margin-bottom: .35rem;
	}
	#map-viewer-map {
		width: 100%;
		height: 70vh;
		min-height: 380px;
		background: white;
	}
	#map-viewer-map.map-viewer-loading,
	#map-viewer-map.map-viewer-loading .ol-viewport {
		cursor: progress !important;
	}
	.map-viewer-map-panel {
		position: relative;
	}
	.map-viewer-layer-menu-button {
		position: absolute;
		z-index: 6;
		top: .75rem;
		right: .75rem;
		display: grid;
		gap: 4px;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 1px solid #aaa;
		border-radius: .25rem;
		background: rgba(255, 255, 255, .95);
		cursor: pointer;
	}
	.map-viewer-layer-menu-button span {
		display: block;
		height: 2px;
		background: #333;
	}
	.map-viewer-layer-menu {
		position: absolute;
		z-index: 7;
		top: 3.75rem;
		right: .75rem;
		width: min(320px, calc(100% - 1.5rem));
		max-height: min(70vh, 480px);
		overflow: auto;
		padding: .5rem;
		background: rgba(255, 255, 255, .98);
		border: 1px solid #aaa;
		border-radius: .25rem;
		box-shadow: 0 2px 8px rgba(0, 0, 0, .2);
	}
	.map-viewer-layer-menu[hidden] {
		display: none !important;
	}
	#map-viewer-layer-menu-l1 {
		width: 100%;
		max-height: none;
		border: 0;
		box-shadow: none;
	}
	.map-viewer-layer-menu-clickable {
		cursor: pointer;
	}
	.map-viewer-layer-menu-clickable:hover,
	.map-viewer-layer-menu-clickable:focus {
		background: #e9ecef;
	}
	.map-viewer-layer-menu-selected {
		font-weight: bold;
		background: #abd3f6;
	}
	#map-viewer-legend {
		position: absolute;
		z-index: 5;
		right: 1rem;
		bottom: 1rem;
		max-width: 220px;
		padding: .5rem;
		background: rgba(255, 255, 255, .92);
		border: 1px solid #aaa;
		border-radius: .25rem;
	}
	#map-viewer-legend img {
		display: block;
		max-width: 200px;
		max-height: 300px;
	}
	#map-viewer-status {
		min-height: 1.5rem;
		margin: .5rem 0;
	}
	#map-viewer-results {
		margin-top: 1rem;
		padding: 1rem;
		background: white;
		border-radius: .35rem;
	}
	.map-viewer-feature {
		padding: 1rem 0;
		border-bottom: 1px solid #dee2e6;
	}
	.map-viewer-feature:last-child {
		border-bottom: 0;
	}
	.map-viewer-property-table {
		width: 100%;
		margin-bottom: 1rem;
		border-collapse: collapse;
	}
	.map-viewer-property-table th,
	.map-viewer-property-table td {
		padding: .4rem .6rem;
		border: 1px solid #dee2e6;
		text-align: left;
		vertical-align: top;
		overflow-wrap: anywhere;
	}
	.map-viewer-property-table th {
		width: 25%;
		background: #f4f7fa;
	}
	.map-viewer-chart {
		width: 100%;
		min-height: 320px;
	}
	.map-viewer-series-controls {
		margin-bottom: .5rem;
	}
	.map-viewer-series-table {
		width: 100%;
		border-collapse: collapse;
	}
	.map-viewer-series-table th,
	.map-viewer-series-table td {
		padding: .4rem .6rem;
		border: 1px solid #dee2e6;
		text-align: left;
	}
	.map-viewer-series-table th {
		background: #f4f7fa;
	}
	.map-viewer-no-series {
		color: #6c757d;
	}
	.slider-width50 {
		width: 50px;
	}
	@media (max-width: 600px) {
		.map-viewer-controls > .form-group {
			width: 100%;
		}
		.map-viewer-layer-menu {
			width: min(320px, calc(100% - 1rem));
			right: .5rem;
		}
		.map-viewer-layer-menu-button {
			top: .5rem;
			right: .5rem;
		}
		#map-viewer-map {
			height: 65vh;
			min-height: 320px;
		}
	}
</style>
<main class="map-viewer-page">
	<h2>Visor de campos</h2>
	<form id="map-viewer-form" class="map-viewer-controls">
		<div class="form-group">
			<label for="map-viewer-timestart">Inicio</label>
			<input id="map-viewer-timestart" name="timestart" type="date" class="form-control">
		</div>
		<div class="form-group">
			<label for="map-viewer-timeend">Fin</label>
			<input id="map-viewer-timeend" name="timeend" type="date" class="form-control">
		</div>
		<div class="form-group">
			<label for="map-viewer-function">Función</label>
			<select id="map-viewer-function" name="function" class="form-control">
				<option value="sum">sum</option>
				<option value="avg">avg</option>
				<option value="min">min</option>
				<option value="max">max</option>
				<option value="count">count</option>
				<option value="stddev">stddev</option>
			</select>
		</div>
		<div class="form-group" style="flex: 1; min-width: 240px;">
			<label for="map-viewer-layer">Capa</label>
			<select id="map-viewer-layer" name="layer"></select>
		</div>
		<button type="submit" class="btn btn-primary" title="Recargar capa con los filtros seleccionados">Aplicar</button>
		<a href="" target="_blank" id="download-layer" style="font-size: 34px;"><i class="fa-solid fa-file-arrow-down"></i></a>
	</form>
	<div id="map-viewer-status" role="status" aria-live="polite"></div>
	<div class="map-viewer-map-panel">
		<div id="map-viewer-map" role="application" aria-label="Mapa"></div>
		<button id="map-viewer-layer-menu-button" class="map-viewer-layer-menu-button" type="button"
			aria-label="Mostrar capas" aria-controls="map-viewer-layer-menu" aria-expanded="false" title="Seleccionar capa">
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
		<div id="map-viewer-layer-menu" class="map-viewer-layer-menu" hidden>
			<ul id="map-viewer-layer-menu-l1"></ul>
		</div>
		<div id="map-viewer-legend">
			<strong id="map-viewer-legend-title">Leyenda</strong>
			<img id="map-viewer-legend-image" alt="Leyenda de la capa WMS">
			<span id="map-viewer-legend-unavailable" hidden>La leyenda no está disponible.</span>
			<input type="range" value="1" class="slider-width50" id="opprod" min="0" max="1" step="0.1">
		</div>
	</div>
	<section id="map-viewer-results" hidden aria-live="polite">
		<h3>Elementos consultados</h3>
		<div id="map-viewer-feature-results"></div>
	</section>
</main>
<script>
	window.mapViewerConfig = {{{mapViewerConfig}}};
</script>
